{
  "name": "viensjouer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Viens jouer — parents coordinate their toddlers' play-dates, park meet-ups and birthdays. One Worker + D1 + a Vite SPA; the invited parent needs no account.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply viensjouer --local",
    "db:migrate:prod": "wrangler d1 migrations apply viensjouer --remote",
    "verify": "npm run typecheck && npm run knip && npm test && npm run build && npm run check:bundle",
    "deploy": "npm run build && wrangler deploy",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --workers=1 --retries=0 --forbid-only",
    "check:bundle": "node scripts/check-bundle.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "knip": "^6.43.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.1"
  }
}
