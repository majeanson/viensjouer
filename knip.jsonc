{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Handlers under functions/api are entries: worker/routes.ts dispatches to them by name, which knip cannot see.
  "entry": ["functions/api/**/*.ts", "scripts/*.mjs", "e2e/**/*.ts"],
  "project": ["src/**/*.{ts,tsx}", "worker/**/*.ts", "functions/**/*.ts", "scripts/**/*.mjs"],
  "ignoreExportsUsedInFile": true
}
